#!/bin/sh
# claude-t: Claude Code through Trioditis, for this one process only. Same arguments as `claude`.
#
# Your claude.ai login stays the credential: Trioditis passes it to Anthropic untouched and only counts
# tokens (`trioditis usage --plan`). If Trioditis isn't answering, Claude Code starts direct, unmetered,
# and says so. Nothing outside this process changes; plain `claude` is never routed.
#
#   TRIODITIS_URL      the router (default http://127.0.0.1:8787)
#   TRIODITIS_API_KEY  the router key, if the router has one: sent as X-Trioditis-Key, never as Authorization
set -eu

url="${TRIODITIS_URL:-http://127.0.0.1:8787}"
url="${url%/}"

# The login token travels to this URL with every request: this machine or https only, and no user@host form.
case "$url" in
    *@*) echo "claude-t: TRIODITIS_URL has an @ in it. Give the router's address without a user or password." >&2
         exit 2 ;;
    https://*|http://127.0.0.1|http://127.0.0.1:*|http://localhost|http://localhost:*|http://\[::1\]|http://\[::1\]:*) ;;
    *) echo "claude-t: TRIODITIS_URL is $url. Plain http is only for this machine (127.0.0.1, localhost, [::1]): use https, or unset it." >&2
       exit 2 ;;
esac

if curl -fsS --max-time 2 "$url/health" 2>/dev/null | grep -q '"anthropic_gate":true'; then
    export ANTHROPIC_BASE_URL="$url"
    if [ -n "${TRIODITIS_API_KEY:-}" ]; then
        nl='
'
        export ANTHROPIC_CUSTOM_HEADERS="${ANTHROPIC_CUSTOM_HEADERS:+$ANTHROPIC_CUSTOM_HEADERS$nl}X-Trioditis-Key: $TRIODITIS_API_KEY"
    fi
else
    echo "claude-t: no Trioditis with the Anthropic gate at $url (down, or older than the gate); starting Claude Code direct, not metered." >&2
fi

exec claude "$@"
